# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# STUDIO_ADMIN_PASSWORD: Password for DabourStudio CMS Admin Portal (/admin).
# Defaults to "dabour-admin-2026" in local/dev if not set.
STUDIO_ADMIN_PASSWORD="dabour-admin-2026"

# SUPABASE_URL: Project URL from Supabase Settings > API
SUPABASE_URL="MY_SUPABASE_URL"

# SUPABASE_SERVICE_ROLE_KEY: Service Role Key from Supabase Settings > API
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"
